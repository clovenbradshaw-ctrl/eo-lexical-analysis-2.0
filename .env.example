# EO Lexical Analysis — API credentials
#
# Copy this file to .env and fill in your keys. main.py will load .env
# automatically (via python-dotenv) and persist any new values you enter
# at the interactive prompt back into .env.

# Anthropic — used for Claude classifier (Phase 2)
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — used for GPT-4o classifier (Phase 2) AND text-embedding-3-large (Phase 3)
# OpenAI is required: embeddings are computed with text-embedding-3-large.
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional — Google AI Studio key, enables Gemini as a third classifier
# Leave unset to skip Gemini.
# GEMINI_API_KEY=
